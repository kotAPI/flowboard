{
  "name": "flowboard-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "routes": "tsx src/print-routes.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
