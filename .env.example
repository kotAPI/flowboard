# Copy to .env to override defaults. No secrets here: these are local-dev values.
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_DB=flowboard
JWT_SECRET=dev-only-secret-change-me
# Allow the mock `X-User-Id` header. Set to false to require Bearer JWTs only.
ALLOW_DEV_HEADER_AUTH=true
SEED_ON_BOOT=true
# Log the "task updated" webhook payloads the worker would POST
WEBHOOK_LOG=true
WEB_PORT=8080
API_PORT=3000
DB_PORT=5433
